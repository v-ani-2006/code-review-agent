# ==============================================================================
# .gitignore — Git Exclusions for CodePilot AI
# Phase 13 DevOps Toolchain
# ==============================================================================

# Byte-compiled / optimized / C-extension files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDEs & editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing, QA & Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage_html/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Uploads & Temporary Runtime Data
uploads/*
!uploads/.gitkeep
uploads/temp/*
uploads/extracted/*
uploads/reports/*

# Reports & Deliverables
reports/*
!reports/.gitkeep

# Application & Gunicorn Logs
logs/*
!logs/.gitkeep
*.log

# Database Backups & Dumps
backups/*
!backups/.gitkeep
*.sql
*.sql.gz

# Frontend Node Dependencies (Placeholder)
node_modules/
.next/
dist-web/
tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker & local volumes
*.pid
.docker/
app/uploads/