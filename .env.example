# Application Configuration Template
# Copy this file to .env and customize values for your local environment

APP_NAME="code-review-agent"
APP_VERSION="0.1.0"
DEBUG=True
API_PREFIX=""
ENABLE_DOCS=True

# Database Configuration (PostgreSQL)
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="codepilot_db"
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres_password"

# Optional: Full Database URL override (if provided, overrides individual components)
# Async URL for FastAPI/SQLAlchemy async engine: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=""

# JWT Authentication & OAuth2 Configuration
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI Integration (Phase 6)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# Redis & Caching (Phase 10)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
API_KEY_HEADER="X-API-Key"

# Metrics & Webhooks
ENABLE_METRICS=True
PROMETHEUS_ENABLED=True
ENABLE_WEBHOOKS=True
WEBHOOK_SECRET="codepilot-super-secret-webhook-key-32chars"

# File Storage & Limits (Phase 12)
UPLOAD_DIR="app/uploads/temp"
REPORTS_DIR="app/reports"
UPLOAD_LIMIT_MB=25

# Process & Server (Phase 12)
WORKERS=2
TIMEOUT=120
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1"
