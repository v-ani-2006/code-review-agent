# ==============================================================================
# .editorconfig — Consistent Coding Styles Across IDEs & Editors
# CodePilot AI — Phase 13 DevOps Toolchain
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{sh,bash}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
